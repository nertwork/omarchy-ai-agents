    "settingsSchema": [
      {
        "key": "localhostOnly",
        "label": "Localhost-only collection",
        "type": "bool",
        "default": false
      },
      {
        "key": "aggregateByDefault",
        "label": "Aggregate totals by default",
        "type": "bool",
        "default": true
      },
      {
        "key": "showAggregatedSummary",
        "label": "Show aggregated summary banner",
        "type": "bool",
        "default": true
      },
      {
        "key": "showBarCost",
        "label": "Show cost in status bar",
        "type": "bool",
        "default": true
      },
      {
        "key": "barDisplayMode",
        "label": "Bar display mode",
        "type": "enum",
        "default": "aggregated",
        "options": [
          {
            "label": "Aggregated Total ($)",
            "value": "aggregated"
          },
          {
            "label": "Active Module ($)",
            "value": "active"
          },
          {
            "label": "Icon Only",
            "value": "icon"
          }
        ]
      },
      {
        "key": "pollIntervalSeconds",
        "label": "Poll Interval (seconds)",
        "type": "number",
        "default": 300,
        "min": 60,
        "max": 3600,
        "step": 30
      },
      {
        "key": "terminalCommand",
        "label": "Terminal Command Override",
        "type": "string",
        "default": "",
        "placeholder": "e.g. ghostty -e or alacritty -e"
      }
    ],
    "defaultSection": "right",
    "displayName": "AI Agents",
    "description": "Modular AI coding agent usage, cost, and quota monitor across Antigravity (AGY), Claude Code, OpenAI Codex, GitHub Copilot, and Grok.",
