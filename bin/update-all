#!/bin/bash
# Self-contained Agent Usage Update runner for Omarchy Agents plugin (nertwork.agents).
# Strictly localhost-only execution; delegates AGY, Claude (+ split profiles), Codex, Grok, and Copilot to collector.py.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Run upstream collector for any other providers (e.g. Fireworks), excluding codex and claude
# since collector.py handles modular AGY, Claude (personal + fiserv-claude), Codex, Grok, and Copilot.
if command -v omarchy-agent-usage-update >/dev/null 2>&1; then
  omarchy-agent-usage-update --except codex --except claude "$@" 2>/dev/null || true
fi

python3 "$SCRIPT_DIR/collector.py" "$@"
