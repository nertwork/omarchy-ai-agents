#!/bin/bash
# Self-contained Agent Usage Update runner for Omarchy Agents plugin (nertwork.agents).
# Syncs remote hosts (controller, gpu01, netctl1, netctl2) in background and runs collector.py.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$SCRIPT_DIR/sync-remote-hosts" ]]; then
  "$SCRIPT_DIR/sync-remote-hosts" "$@" >/dev/null 2>&1 &
fi

if command -v omarchy-agent-usage-update >/dev/null 2>&1; then
  omarchy-agent-usage-update --except codex --except claude --except fireworks --except openrouter --except gemini "$@" 2>/dev/null || true
fi

python3 "$SCRIPT_DIR/collector.py" "$@"
