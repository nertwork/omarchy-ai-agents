#!/usr/bin/env bash
# Collect local + remote usage for all AI assistant profiles.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$SCRIPT_DIR/sync-remote-hosts" ]]; then
  if [[ " $* " == *" --force "* ]]; then
    timeout 15 "$SCRIPT_DIR/sync-remote-hosts" >/dev/null 2>&1 || true
  else
    (
      if "$SCRIPT_DIR/sync-remote-hosts" >/dev/null 2>&1; then
        python3 "$SCRIPT_DIR/collector.py" >/dev/null 2>&1 || true
      fi
    ) &
  fi
fi

exec python3 "$SCRIPT_DIR/collector.py" "$@"
