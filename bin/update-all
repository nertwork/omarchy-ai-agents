#!/usr/bin/env bash
# Collects usage metrics across all enabled AI Agents profiles in a single pass.
# collector.py handles modular AGY, Claude (personal + claude-work), Codex, Grok, Fireworks, and Copilot.
set -euo pipefail

export PYTHONDONTWRITEBYTECODE=1
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$SCRIPT_DIR/collector.py" ]]; then
  python3 -B "$SCRIPT_DIR/collector.py" "$@" || true
fi
